# ── VinylPrice Environment Variables ────────────────────────────
# Copy this file to ".env" and fill in your keys.
# The app works without any keys (Discogs public API is free),
# but you'll need SERPAPI_KEY for Amazon, eBay, Target, Walmart results.

# ── SerpAPI (Google Shopping) ──────────────────────────────────
# Sign up at https://serpapi.com  (free tier = 100 searches/month)
# Paid plans start at $50/mo for 5,000 searches
SERPAPI_KEY=your_serpapi_key_here

# ── Discogs API Token (optional) ──────────────────────────────
# Get a free token at https://www.discogs.com/settings/developers
# Without a token the app still works, but rate limits are tighter
DISCOGS_TOKEN=your_discogs_token_here

# ── Affiliate IDs (add these once you sign up) ─────────────────
# Amazon Associates: https://affiliate-program.amazon.com
AMAZON_AFFILIATE_ID=yoursite-20

# eBay Partner Network: https://partnernetwork.ebay.com
EBAY_AFFILIATE_ID=your_ebay_pub_id

# Discogs Affiliate: https://www.discogs.com/group/thread/867986
DISCOGS_AFFILIATE_ID=your_discogs_ref

# ── Server ─────────────────────────────────────────────────────
PORT=3000
